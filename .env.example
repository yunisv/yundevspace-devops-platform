# Copy to .env and fill in before running `docker compose up`.
# Never commit the real .env file.

# --- Domain / TLS ---
BASE_DOMAIN=devops.example.com
ACME_EMAIL=admin@example.com
# Hetzner DNS API token (dns.hetzner.com -> API tokens). Certificates are
# issued via the DNS-01 challenge so no inbound port has to be open, and so
# a single wildcard cert covers every subdomain.
HETZNER_API_KEY=

# --- Network / access ------------------------------------------------------
# This server's IP on the NetBird mesh (see docs/vpn-netbird.md) — NOT the
# public IP. Traefik binds only here, so the platform never listens on the
# public interface at all. Only exists after installing the NetBird client
# on this host and running `netbird up`. Find it with:
#   ip -4 -o addr show wt0
BIND_ADDRESS=100.64.0.2

# NetBird's mesh network CIDR (its default CGNAT range; check Settings ->
# Network Routes in the NetBird dashboard if you changed it). Only peers in
# this range can reach the internal services.
VPN_SUBNET=100.64.0.0/10

# Subnet for the platform's own docker network. Pinned explicitly so the
# allow-list can name it exactly instead of covering all of 172.16.0.0/12.
DOCKER_SUBNET=172.28.0.0/16
# Traefik dashboard basic-auth is NOT set here — passing an htpasswd hash
# through an env var breaks (docker compose re-interpolates embedded `$`
# characters). Instead ./scripts/install.sh generates secrets/dashboard.htpasswd
# directly, mounted into the Traefik container. See docs/architecture.md.

# --- Keycloak (SSO for GitLab/Grafana/n8n/dashboard) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
# Realm you create in Keycloak for the platform (see docs/dashboard-sso.md).
KEYCLOAK_REALM=devops

# --- Dashboard (Homepage behind Keycloak SSO via oauth2-proxy) ---
# Filled in after creating the oauth2-proxy client in Keycloak; the cookie
# secret is generated automatically by ./scripts/install.sh.
OAUTH2_PROXY_CLIENT_ID=oauth2-proxy
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=

# --- GitLab CE (VCS + CI/CD + issues + registry + SAST) ---
GITLAB_ROOT_PASSWORD=change-me-min-8-chars
# Generated from Admin Area > CI/CD > Runners > New instance runner,
# after GitLab's first boot (see docs/architecture.md).
GITLAB_RUNNER_TOKEN=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- n8n (automation / future AI-agent orchestration) ---
# Encrypts stored credentials. Changing it later makes existing n8n
# credentials unreadable, so set it once and keep it.
# n8n has no basic-auth setting (removed in 1.0) — you create the owner
# account in the UI on first visit.
N8N_ENCRYPTION_KEY=change-me-32-chars-min
