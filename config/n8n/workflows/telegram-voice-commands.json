{
  "name": "Telegram Voice Commands",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-poll",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "t1-webhook",
      "name": "Poll Tick",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1400, 220]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "seconds", "secondsInterval": 180 }
          ]
        }
      },
      "id": "t1-schedule",
      "name": "Safety Net Every 3min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1400, 380]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Основной цикл (Poll Tick) сам себя дёргает без пауз и обновляет\n// lastTick в Get Offset на каждой итерации (максимум раз в ~25с). Если\n// он жив — тут просто ничего не делаем, чтобы не плодить второй\n// параллельный цикл, конкурирующий за один и тот же getUpdates.\nconst staticData = $getWorkflowStaticData('global');\nconst last = staticData.lastTick || 0;\nconst alive = (Date.now() - last) < 90000;\nif (alive) return [];\nreturn [{ json: {} }];"
      },
      "id": "t1b-gate",
      "name": "Safety Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1180, 420]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// lastTick — метка \"цикл жив\", проверяется в Safety Gate: пока Poll\n// Tick сам себя перезапускает без пауз, Safety Net не должен запускать\n// параллельный второй такой же цикл (Telegram разрешает только один\n// активный long-poll на бота — второй тут же обрывается конфликтом).\nconst staticData = $getWorkflowStaticData('global');\nstaticData.lastTick = Date.now();\nreturn [{ json: { offset: staticData.offset || 0 } }];"
      },
      "id": "t2-get-offset",
      "name": "Get Offset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1180, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/bot8134918535:AAHacy6lYzn_1oQ1E_26D3lzWJ8VYrsBPLs/getUpdates?offset={{ $json.offset }}&timeout=25",
        "options": {
          "timeout": 35000
        }
      },
      "id": "t3-get-updates",
      "name": "Get Updates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [-960, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Telegram сам не отдаёт боту обычную переписку в группе (privacy\n// mode) — сюда долетают только команды/упоминания/реплаи боту, фильтр\n// по chat_id — на случай, если бота добавят ещё куда-то.\n// Голос ИЛИ текст — оба варианты команды. Фото/документы без голоса\n// или текста пока не триггерят действие сами по себе — вложения к\n// команде подхватываются отдельно на Этапе 4 (create_task), Telegram\n// не даёт прикрепить голос+фото в одном сообщении.\nconst result = $input.first().json.result || [];\nconst staticData = $getWorkflowStaticData('global');\nlet maxUpdateId = (staticData.offset || 1) - 1;\nconst TARGET_CHAT_ID = '-1003913344004';\nconst items = [];\nfor (const update of result) {\n  if (update.update_id > maxUpdateId) maxUpdateId = update.update_id;\n  const msg = update.message;\n  if (!msg) continue;\n  if (String(msg.chat.id) !== TARGET_CHAT_ID) continue;\n  if (!msg.voice && !msg.text) continue;\n  items.push({ json: msg });\n}\nstaticData.offset = maxUpdateId + 1;\nreturn items;"
      },
      "id": "t4-extract",
      "name": "Extract Commands",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-740, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ !!$json.voice }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ]
        },
        "options": {}
      },
      "id": "t4b-has-voice",
      "name": "Has Voice",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-620, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Приводим к тому же виду, что отдаёт Whisper (поле data — JSON-строка\n// с полем text), чтобы Reply in Telegram работал одинаково для обеих\n// веток (голос/текст).\nreturn { json: { data: JSON.stringify({ text: $json.text }) } };"
      },
      "id": "t4c-text",
      "name": "Use Text As Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-520, 460]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/bot8134918535:AAHacy6lYzn_1oQ1E_26D3lzWJ8VYrsBPLs/getFile?file_id={{ $json.voice.file_id }}",
        "options": {}
      },
      "id": "t5-get-file-path",
      "name": "Get File Path",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-380, 220]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/file/bot8134918535:AAHacy6lYzn_1oQ1E_26D3lzWJ8VYrsBPLs/{{ $json.result.file_path }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "t6-download",
      "name": "Download Voice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://whisper:9000/asr?output=json&language=ru",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "audio_file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "t7-whisper",
      "name": "Whisper Transcribe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [-80, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8134918535:AAHacy6lYzn_1oQ1E_26D3lzWJ8VYrsBPLs/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: \"-1003913344004\", text: \"✅ Принято: \" + (JSON.parse($json.data || \"{}\").text || \"(не удалось распознать)\") }) }}",
        "options": {}
      },
      "id": "t8-reply",
      "name": "Reply in Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [140, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/telegram-poll",
        "options": {
          "timeout": 5000
        }
      },
      "id": "t9-continue",
      "name": "Continue Polling",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [-740, 460]
    }
  ],
  "connections": {
    "Poll Tick": {
      "main": [[{ "node": "Get Offset", "type": "main", "index": 0 }]]
    },
    "Safety Net Every 3min": {
      "main": [[{ "node": "Safety Gate", "type": "main", "index": 0 }]]
    },
    "Safety Gate": {
      "main": [[{ "node": "Get Offset", "type": "main", "index": 0 }]]
    },
    "Get Offset": {
      "main": [[{ "node": "Get Updates", "type": "main", "index": 0 }]]
    },
    "Get Updates": {
      "main": [[
        { "node": "Extract Commands", "type": "main", "index": 0 },
        { "node": "Continue Polling", "type": "main", "index": 0 }
      ]]
    },
    "Extract Commands": {
      "main": [[{ "node": "Has Voice", "type": "main", "index": 0 }]]
    },
    "Has Voice": {
      "main": [
        [{ "node": "Get File Path", "type": "main", "index": 0 }],
        [{ "node": "Use Text As Transcript", "type": "main", "index": 0 }]
      ]
    },
    "Get File Path": {
      "main": [[{ "node": "Download Voice", "type": "main", "index": 0 }]]
    },
    "Download Voice": {
      "main": [[{ "node": "Whisper Transcribe", "type": "main", "index": 0 }]]
    },
    "Whisper Transcribe": {
      "main": [[{ "node": "Reply in Telegram", "type": "main", "index": 0 }]]
    },
    "Use Text As Transcript": {
      "main": [[{ "node": "Reply in Telegram", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
