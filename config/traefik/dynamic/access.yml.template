# Template — ./scripts/install.sh renders this into access.yml with the
# subnets from .env substituted in.
#
# Second line of defence. Traefik already binds only to the NetBird
# interface (BIND_ADDRESS), so nothing reaches it from the public internet
# at all; this additionally rejects anything that isn't a NetBird peer or
# the platform's own docker network.
http:
  middlewares:
    internal-only:
      ipAllowList:
        sourceRange:
          - "__VPN_SUBNET__"
          - "__DOCKER_SUBNET__"
          - "127.0.0.1/32"
