# Template — ./scripts/install.sh renders this into tls.yml with the real
# domain substituted (the file provider can't expand variables itself).
#
# A single wildcard certificate serves every subdomain. Besides being fewer
# ACME requests, it keeps subdomain names out of the public Certificate
# Transparency logs — with per-subdomain certs, anyone can enumerate
# git./prometheus./dash. and map the infrastructure.
tls:
  stores:
    default:
      defaultGeneratedCert:
        resolver: le
        domain:
          main: "__BASE_DOMAIN__"
          sans:
            - "*.__BASE_DOMAIN__"
